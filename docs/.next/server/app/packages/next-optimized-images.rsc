dren":["Improves loading speed by providing ",["$","strong",null,{"children":"progressive images"}]," (for formats that support it)"]}],"\n",["$","li",null,{"className":"x:my-[.5em]","children":[["$","strong",null,{"children":"Inlines small images"}]," to save HTTP requests and additional roundtrips"]}],"\n",["$","li",null,{"className":"x:my-[.5em]","children":"Adds a content hash to the file name so images can get cached on CDN level and in the browser for a long time"}],"\n",["$","li",null,{"className":"x:my-[.5em]","children":"Same image URLs over multiple builds for long time caching"}],"\n",["$","li",null,{"className":"x:my-[.5em]","children":["Provides ",["$","strong",null,{"children":["$","a",null,{"href":"#query-params","className":"x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font]","children":"query params"}]}]," for file-specific handling/settings"]}],"\n",["$","li",null,{"className":"x:my-[.5em]","children":["jpeg/png images can be ",["$","strong",null,{"children":["converted to ",["$","a",null,{"href":"#webp","className":"x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font]","children":[["$","code",null,{"className":"nextra-code","dir":"ltr","children":"webp"}]," on the fly"]}]]}]," for an even smaller size"]}],"\n",["$","li",null,{"className":"x:my-[.5em]","children":["Provides the possibility to use ",["$","strong",null,{"children":["$","a",null,{"href":"#sprite","className":"x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font]","children":["$","code",null,{"className":"nextra-code","dir":"ltr","children":"SVG sprites"}]}]}]," for a better performance when using the same icons multiple times (e.g. in a list)"]}],"\n",["$","li",null,{"className":"x:my-[.5em]","children":["Can ",["$","stro