{
  "name": "@opensourceframework/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "OpenSourceFramework - A collection of maintained Next.js packages",
  "workspaces": [
    "packages/*",
    "tools/*",
    "docs",
    "showcase"
  ],
  "scripts": {
    "prepare": "husky install",
    "test": "turbo run test",
    "test:compat": "node scripts/test-compat.mjs",
    "test:coverage": "turbo run test:coverage",
    "test:ci": "turbo run test:ci",
    "test:types": "turbo run test:types",
    "test:api": "turbo run test:api",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "build:all": "turbo run build",
    "bundle-size": "pnpm run build && bundle-phobia-cli @opensourceframework/next-compose-plugins --limit 10",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "release": "changeset version && pnpm install && turbo run build --filter='./packages/*'",
    "publish": "changeset publish",
    "audit": "pnpm audit --audit-level=low",
    "audit:moderate": "pnpm audit --audit-level=moderate"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.4.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.0",
    "globals": "^17.4.0",
    "husky": "^9.0.10",
    "lint-staged": "^16.3.3",
    "prettier": "^3.2.4",
    "turbo": "^2.9.14",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.6.0"
  },
  "packageManager": "pnpm@9.6.0",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "serialize-javascript": "^7.0.5",
      "undici": "^7.24.0",
      "happy-dom": "^20.9.0",
      "esbuild": "^0.25.0",
      "flatted": "^3.4.2",
      "picomatch@^2.0.0": "2.3.2",
      "picomatch@^4.0.0": "4.0.4",
      "next": ">=16.2.6",
      "vite@^5.0.0": "^6.4.2",
      "vite@^6.0.0": "^6.4.2",
      "vite@^7.0.0": "7.3.3",
      "axios": ">=1.15.2",
      "fast-uri": ">=3.1.2",
      "ws": ">=8.20.1",
      "tar-fs": ">=3.1.1",
      "tar": ">=7.5.15",
      "basic-ftp": "5.3.1",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "brace-expansion@^1.1.7": "1.1.14",
      "brace-expansion@^2.0.1": "2.1.0",
      "brace-expansion@^5.0.0": "5.0.6",
      "@xmldom/xmldom": "^0.9.10",
      "@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "postcss@<8.5.10": "8.5.15",
      "yaml": "^2.8.3",
      "dompurify": ">=3.4.0",
      "mermaid": ">=11.15.0",
      "ip-address": ">=10.1.1",
      "uuid": ">=11.1.1"
    }
  },
  "dependencies": {
    "oauth": "^0.10.2",
    "pino": "^10.3.1"
  }
}
