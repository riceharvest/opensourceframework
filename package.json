{
  "name": "@opensourceframework/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "OpenSourceFramework - A collection of maintained Next.js packages",
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "prepare": "husky install",
    "test": "turbo run test",
    "test:compat": "node scripts/test-compat.mjs",
    "test:coverage": "turbo run test:coverage",
    "test:ci": "turbo run test:ci",
    "test:types": "turbo run test:types",
    "test:api": "turbo run test:api",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "build:all": "turbo run build",
    "bundle-size": "pnpm run build && bundle-phobia-cli @opensourceframework/next-compose-plugins --limit 10",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "release": "changeset version && pnpm install && turbo run build --filter='./packages/*'",
    "publish": "changeset publish",
    "audit": "pnpm audit --audit-level=low",
    "audit:moderate": "pnpm audit --audit-level=moderate"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.4.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.0",
    "globals": "^17.4.0",
    "husky": "^9.0.10",
    "lint-staged": "^16.3.3",
    "prettier": "^3.2.4",
    "turbo": "^2.8.15",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "serialize-javascript": "^7.0.3",
      "undici": "^7.24.0",
      "happy-dom": "^20.0.0",
      "esbuild": "^0.25.0",
      "flatted": "^3.4.2",
      "next": ">=16.1.7",
      "ws": ">=8.17.1",
      "tar-fs": ">=3.1.1",
      "tar": ">=7.5.15"
    }
  },
  "dependencies": {
    "oauth": "^0.10.2",
    "pino": "^10.3.1"
  }
}
