{
  "name": "@opensourceframework/next-optimized-images",
  "version": "2.6.2",
  "description": "Automatically optimize images used in next.js projects (jpeg, png, gif, svg).",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "lib",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup && mkdir -p dist/loaders && cp -rv lib/loaders/* dist/loaders/",
    "watch": "tsup --watch",
    "lint": "eslint . --ignore-pattern examples",
    "lint:fix": "eslint . --ignore-pattern examples --fix",
    "test": "vitest run --globals",
    "test:coverage": "vitest run --globals --coverage",
    "test:watch": "vitest --globals"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riceharvest/opensourceframework.git",
    "directory": "packages/next-optimized-images"
  },
  "keywords": [
    "nextjs",
    "next",
    "react",
    "plugin",
    "images",
    "optimize",
    "optimized-images"
  ],
  "author": "OpenSource Framework Contributors (fork), Original: Cyril Wanner",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/riceharvest/opensourceframework/issues?q=is%3Aissue+is%3Aopen+next-optimized-images"
  },
  "homepage": "https://github.com/riceharvest/opensourceframework/tree/main/packages/next-optimized-images#readme",
  "dependencies": {
    "chalk": "^2.4.2",
    "figures": "^3.0.0",
    "file-loader": "^6.2.0",
    "loader-utils": "^3.3.1",
    "raw-loader": "^4.0.2",
    "url-loader": "^4.1.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "next": "^16.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "webpack": "^5.105.4"
  },
  "peerDependencies": {
    "next": ">=12.0.0 <22.0.0 || ^16.0.0",
    "react": ">=18.2.0 <22.0.0 || ^19.0.0",
    "react-dom": ">=18.2.0 <22.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
