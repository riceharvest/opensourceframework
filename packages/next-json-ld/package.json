{
  "name": "@opensourceframework/next-json-ld",
  "version": "0.2.2",
  "description": "JSON-LD structured data helpers for Next.js SEO - Generate Schema.org markup for search engines",
  "keywords": [
    "next.js",
    "json-ld",
    "structured-data",
    "seo",
    "schema.org",
    "semantic-web",
    "rich-snippets",
    "microdata"
  ],
  "author": "OpenSource Framework Contributors",
  "contributors": [
    {
      "name": "Rice Harvest",
      "url": "https://github.com/riceharvest"
    }
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --ignore-pattern examples",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint-plugin-jest": "^29.15.0",
    "next": "^16.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "next": ">=12.0.0 <22.0.0 || ^16.0.0",
    "react": ">=18.0.0 <22.0.0 || ^19.0.0",
    "react-dom": ">=18.0.0 <22.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riceharvest/opensourceframework.git",
    "directory": "packages/next-json-ld"
  },
  "bugs": {
    "url": "https://github.com/riceharvest/opensourceframework/issues?q=is%3Aissue+is%3Aopen+next-json-ld"
  },
  "homepage": "https://github.com/riceharvest/opensourceframework/tree/main/packages/next-json-ld#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "funding": {
    "type": "GitHub",
    "url": "https://github.com/sponsors/riceharvest"
  }
}
