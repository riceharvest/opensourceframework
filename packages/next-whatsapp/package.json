{
  "name": "@opensourceframework/next-whatsapp",
  "version": "0.1.0",
  "description": "WhatsApp Web.js integration for Next.js applications, extracted from the itsalive project",
  "keywords": [
    "whatsapp",
    "whatsapp-web.js",
    "next.js",
    "nextjs",
    "whatsapp-integration"
  ],
  "author": "OpenSource Framework Contributors",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --ignore-pattern examples",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage node_modules"
  },
  "dependencies": {
    "whatsapp-web.js": "^1.23.0",
    "qrcode": "^1.5.3",
    "@prisma/client": "^5.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3",
    "tsup": "^8.5.1",
    "vitest": "^2.1.9",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "@testing-library/jest-dom": "^6.9.1"
  },
  "peerDependencies": {
    "next": ">=12.0.0 <22.0.0 || ^16.0.0",
    "react": ">=18.0.0 <22.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riceharvest/opensourceframework.git",
    "directory": "packages/next-whatsapp"
  },
  "bugs": {
    "url": "https://github.com/riceharvest/opensourceframework/issues?q=is%3Aissue+is%3Aopen+next-whatsapp"
  },
  "homepage": "https://github.com/riceharvest/opensourceframework/tree/main/packages/next-whatsapp#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "funding": {
    "type": "GitHub",
    "url": "https://github.com/sponsors/riceharvest"
  }
}
