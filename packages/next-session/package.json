{
  "type": "module",
  "name": "@opensourceframework/next-session",
  "version": "4.0.5",
  "description": "Simple promise-based session for Next.js",
  "keywords": [
    "nextjs",
    "session",
    "promise",
    "express-session"
  ],
  "main": "./lib/session.cjs",
  "exports": {
    ".": {
      "types": "./lib/session.d.ts",
      "import": "./lib/session.js",
      "require": "./lib/session.cjs"
    },
    "./lib/compat": {
      "types": "./lib/compat.d.ts",
      "import": "./lib/compat.js",
      "require": "./lib/compat.cjs"
    }
  },
  "types": "lib/session.d.ts",
  "files": [
    "lib/",
    "llms.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --ignore-pattern examples --ignore-pattern lib --ignore-pattern dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riceharvest/opensourceframework.git",
    "directory": "packages/next-session"
  },
  "author": "OpenSource Framework Contributors (fork), Original: Unknown",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/riceharvest/opensourceframework/issues?q=is%3Aissue+is%3Aopen+next-session"
  },
  "homepage": "https://github.com/riceharvest/opensourceframework/tree/main/packages/next-session#readme",
  "devDependencies": {
    "@types/cookie": "^0.4.1",
    "@types/node": "^22.19.15",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint-plugin-jest": "^29.15.0",
    "light-my-request": "^6.6.0",
    "next": "^16.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "next": ">=13.4.0 <22.0.0 || ^16.0.0"
  },
  "dependencies": {
    "cookie": "^0.7.2",
    "nanoid": "^3.3.11"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "contributors": [
    {
      "name": "Unknown",
      "url": "https://github.com/next-session"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "funding": {
    "type": "GitHub",
    "url": "https://github.com/sponsors/riceharvest"
  }
}
