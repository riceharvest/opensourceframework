{
  "name": "@opensourceframework/turn-based-game-engine",
  "version": "0.2.1",
  "description": "Turn-based extraction game engine primitives with deterministic raids, items, maps, enemies, crafting, quests, and skills.",
  "keywords": [
    "game",
    "turn-based",
    "simulation",
    "extraction",
    "engine",
    "typescript"
  ],
  "author": "OpenSource Framework Contributors",
  "contributors": [
    {
      "name": "Rice Harvest",
      "url": "https://github.com/riceharvest"
    }
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --ignore-pattern examples",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint-plugin-jest": "^29.15.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riceharvest/opensourceframework.git",
    "directory": "packages/turn-based-game-engine"
  },
  "bugs": {
    "url": "https://github.com/riceharvest/opensourceframework/issues?q=is%3Aissue+is%3Aopen+turn-based-game-engine"
  },
  "homepage": "https://github.com/riceharvest/opensourceframework/tree/main/packages/turn-based-game-engine#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "funding": {
    "type": "GitHub",
    "url": "https://github.com/sponsors/riceharvest"
  }
}
