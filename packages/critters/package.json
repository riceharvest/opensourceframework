{
  "name": "@opensourceframework/critters",
  "version": "0.0.2",
  "description": "Embedded CSS critical path extraction for Next.js applications",
  "keywords": [
    "critters",
    "critical-css",
    "next.js",
    "css",
    "performance",
    "optimization"
  ],
  "homepage": "https://github.com/riceharvest/opensourceframework/tree/main/packages/critters#readme",
  "bugs": {
    "url": "https://github.com/riceharvest/opensourceframework/issues?q=is%3Aissue+is%3Aopen+critters"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riceharvest/opensourceframework.git",
    "directory": "packages/critters"
  },
  "license": "MIT",
  "author": "OpenSource Framework Contributors",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ignore-pattern examples",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "css-select": "^5.2.2",
    "css-what": "^6.2.2",
    "dom-serializer": "^2.0.0",
    "domhandler": "^5.0.3",
    "htmlparser2": "^9.1.0",
    "postcss": "^8.5.8",
    "postcss-media-query-parser": "^0.2.3"
  },
  "devDependencies": {
    "@opensourceframework/tsconfig": "^1.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "next": "^16.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "next": ">=12.0.0 <22.0.0 || ^16.0.0",
    "react": ">=18.2.0 <22.0.0 || ^19.0.0",
    "react-dom": ">=18.2.0 <22.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
