{
  "name": "@opensourceframework/next-auth",
  "version": "3.29.13",
  "description": "Authentication for Next.js",
  "homepage": "https://github.com/riceharvest/opensourceframework/tree/main/packages/next-auth#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riceharvest/opensourceframework.git",
    "directory": "packages/next-auth"
  },
  "author": "OpenSource Framework Contributors (fork), Original: Iain Collins",
  "bugs": {
    "url": "https://github.com/riceharvest/opensourceframework/issues?q=is%3Aissue+is%3Aopen+next-auth"
  },
  "main": "index.js",
  "types": "./types/index.d.ts",
  "keywords": [
    "react",
    "nodejs",
    "oauth",
    "jwt",
    "oauth2",
    "authentication",
    "nextjs",
    "csrf",
    "oidc",
    "nextauth"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/server/index.mjs",
      "require": "./index.js"
    },
    "./jwt": {
      "types": "./types/jwt.d.ts",
      "import": "./dist/lib/jwt.mjs",
      "require": "./jwt.js"
    },
    "./adapters": {
      "types": "./types/adapters.d.ts",
      "import": "./dist/adapters/index.mjs",
      "require": "./adapters.js"
    },
    "./client": {
      "types": "./types/client.d.ts",
      "import": "./dist/client/index.mjs",
      "require": "./client.js"
    },
    "./providers": {
      "types": "./types/providers.d.ts",
      "import": "./dist/providers/index.mjs",
      "require": "./providers.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "import": "./dist/providers/*.mjs",
      "require": "./dist/providers-cjs/*.cjs"
    },
    "./errors": {
      "types": "./types/errors.d.ts",
      "import": "./dist/lib/errors.mjs",
      "require": "./errors.js"
    }
  },
  "scripts": {
    "build": "node scripts/prebuild.mjs && tsup --config tsup.config.mjs && node scripts/postbuild.mjs",
    "build:js": "tsup --config tsup.config.mjs && node scripts/postbuild.mjs",
    "build:css": "postcss --config config/postcss.config.js src/**/*.css --base src --dir dist && node config/wrap-css.js",
    "dev:setup": "npm i && npm run build:css && cd app && npm i",
    "dev": "cd app && npm run dev",
    "watch": "tsup --config tsup.config.mjs --watch",
    "test": "vitest run --config vitest.config.js --passWithNoTests",
    "test:coverage": "pnpm test",
    "test:e2e": "playwright test --config playwright.config.js",
    "test:ci": "npm run lint && npm run test:types && npm run test",
    "test:types": "pnpm --dir ../.. exec tsc -p packages/next-auth/types/tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "lint": "pnpm --dir ../.. exec eslint packages/next-auth --ignore-pattern packages/next-auth/examples",
    "lint:fix": "pnpm --dir ../.. exec eslint packages/next-auth --ignore-pattern packages/next-auth/examples --fix",
    "version:pr": "node ./config/version-pr"
  },
  "files": [
    "dist",
    "index.js",
    "providers.js",
    "adapters.js",
    "client.js",
    "errors.js",
    "jwt.js",
    "types",
    "llms.txt"
  ],
  "license": "ISC",
  "dependencies": {
    "@babel/runtime": "^7.14.0",
    "futoin-hkdf": "^1.3.2",
    "jose": "^2.0.7",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.5",
    "pkce-challenge": "^2.1.0",
    "preact": "^10.4.1",
    "preact-render-to-string": "^5.1.14",
    "typeorm": "^0.3.28"
  },
  "peerDependencies": {
    "next": "^11.1.4 || ^12 || ^13 || ^14 || ^15 || ^16",
    "react": "^16.13.1 || ^17 || ^18 || ^19",
    "react-dom": "^16.13.1 || ^17 || ^18 || ^19"
  },
  "peerOptionalDependencies": {
    "mongodb": "^3.5.9",
    "mysql": "^2.18.1",
    "mssql": "^6.2.1",
    "pg": "^8.2.1",
    "@prisma/client": "^2.16.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.8.4",
    "@babel/core": "^7.9.6",
    "@babel/plugin-proposal-optional-catch-binding": "^7.14.2",
    "@babel/plugin-transform-runtime": "^7.13.15",
    "@babel/preset-env": "^7.9.6",
    "@babel/preset-react": "^7.13.13",
    "@playwright/test": "^1.56.1",
    "@swc/core": "^1.15.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/nodemailer": "^6.4.2",
    "@types/react": "^19.0.0",
    "autoprefixer": "^10.4.27",
    "babel-preset-preact": "^2.0.0",
    "conventional-changelog-conventionalcommits": "4.4.0",
    "cssnano": "^7.1.3",
    "dotenv": "^8.2.0",
    "fs-extra": "^11.1.1",
    "husky": "^6.0.0",
    "msw": "^2.12.10",
    "next": "^16.0.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "postcss-nested": "^7.0.2",
    "prettier": "^2.2.1",
    "pretty-quick": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "whatwg-fetch": "^3.6.2"
  },
  "prettier": {
    "semi": false
  },
  "release": {
    "branches": [
      "+([0-9])?(.{+([0-9]),x}).x",
      "main",
      {
        "name": "beta",
        "prerelease": true
      },
      {
        "name": "next",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "releasedLabels": false,
          "successComment": false
        }
      ]
    ]
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/balazsorban44"
    }
  ]
}
