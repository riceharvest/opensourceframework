{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false,
    "strict": false,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "WebWorker"]
  },
  "include": ["*.js", "global.d.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts", "test-app/**/*"]
}
