{
  "name": "@opensourceframework/next-images",
  "version": "1.9.1",
  "description": "Compatibility-first image import plugin for Next.js applications",
  "keywords": [
    "next.js",
    "images",
    "image-optimization",
    "nextjs"
  ],
  "author": "OpenSource Framework Contributors (fork), Original: Aref Aslani",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./global.d.ts": "./src/global.d.ts"
  },
  "typesVersions": {
    "*": {
      "global.d.ts": [
        "./src/global.d.ts"
      ]
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/global.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --ignore-pattern examples",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint-plugin-jest": "^29.15.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "@vitest/coverage-v8": "^2.1.9",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riceharvest/opensourceframework.git",
    "directory": "packages/next-images"
  },
  "bugs": {
    "url": "https://github.com/riceharvest/opensourceframework/issues?q=is%3Aissue+is%3Aopen+next-images"
  },
  "homepage": "https://github.com/riceharvest/opensourceframework/tree/main/packages/next-images#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "file-loader": "^6.2.0",
    "url-loader": "^4.1.0"
  }
}
