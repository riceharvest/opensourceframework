{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "lib/**",
        ".next/**",
        "!.next/cache/**",
        "*.js",
        "*.cjs",
        "*.mjs",
        "*.d.ts",
        "*.d.cts",
        "*.d.mts"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "lint:fix": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build", "build"]
    },
    "test:coverage": {
      "dependsOn": ["^build", "build"],
      "outputs": ["coverage/**"]
    },
    "test:types": {
      "dependsOn": ["build"]
    },
    "test:api": {
      "dependsOn": ["build"],
      "outputs": ["etc/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
